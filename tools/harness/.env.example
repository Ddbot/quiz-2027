# tools/harness — local-only. Talks to the local `supabase start` stack
# (same credentials as tools/db) and spawns a real `wrangler dev` for
# apps/party. Never used against production.
# Copy to `.env` (gitignored) and fill in from `supabase status`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Port the harness's own wrangler dev instance listens on — kept distinct
# from apps/party's own default (8787) so this can run alongside a
# developer's own `wrangler dev` without colliding.
WRANGLER_PORT=8799
