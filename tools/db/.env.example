# tools/db — local-only. Talks to the local `supabase start` stack with the
# service-role key, so it can create test/seed users via the Admin API and
# bypass RLS to set up fixtures. Never used against production.
# Copy to `.env` (gitignored) and fill in from `supabase status`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Mailpit catcher, used by test/emailConfirmation.test.ts
MAILPIT_URL=http://127.0.0.1:54324
