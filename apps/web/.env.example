# apps/web — browser-exposed config only. NEVER put a service-role key here.
# Copy to .env.local for local dev; set the real values in the Vercel project.

# PartyServer worker host (no scheme needed). Local: 127.0.0.1:8787
VITE_PARTY_HOST=127.0.0.1:8787

# Supabase (anon key only — safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry browser DSN (optional; init is a no-op when unset)
VITE_SENTRY_DSN=
