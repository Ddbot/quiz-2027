# apps/web/e2e — local Playwright fixture setup only, NEVER used by the
# actual browser bundle (unlike .env.local's VITE_-prefixed vars, these stay
# server-side, read only by e2e/global-setup.ts under plain Node).
# Copy to .env.e2e (gitignored) and fill in from `npx supabase status`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
