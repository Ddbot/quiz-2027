{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-2027-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat provides AsyncLocalStorage, required by @sentry/cloudflare.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "EventRoom", "class_name": "EventRoom" }],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EventRoom"],
    },
  ],
}
