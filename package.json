{
  "name": "quiz-2027",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "pnpm -r --no-bail lint && eslint . --ignore-pattern \"apps/**\" --ignore-pattern \"packages/**\" --ignore-pattern \"tools/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "dev": "pnpm -r --parallel dev",
    "check:shared-isolation": "node scripts/check-shared-isolation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "supabase": "^2.117.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
